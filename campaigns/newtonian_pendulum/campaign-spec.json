{
  "schema_version": 1,
  "campaign_id": "newtonian-pendulum-v1",
  "description": "Synthetic calibration of Research Machine against the known small-angle pendulum length-period relationship.",
  "seed_reveal": "newtonian-pendulum-calibration-seed-v1",
  "lengths_m": [0.2, 0.35, 0.5, 0.75, 1.0, 1.25],
  "repetitions_per_length": 8,
  "oscillations_per_trial": 20,
  "small_angle_max_deg": 10.0,
  "maximum_clock_drift_ppm": 100.0,
  "maximum_relative_length_error": 0.005,
  "maximum_amplitude_loss_fraction": 0.12,
  "maximum_registered_exclusions": 2,
  "minimum_model_rmse_ratio": 3.0,
  "allowed_exclusion_flags": ["sensor_dropout"],
  "cases": [
    {
      "case_id": "clean_square_root",
      "generator_model": "square_root",
      "mutation": "none",
      "expected_model": "square_root",
      "expected_valid": true
    },
    {
      "case_id": "constant_control",
      "generator_model": "constant",
      "mutation": "none",
      "expected_model": "constant",
      "expected_valid": true
    },
    {
      "case_id": "linear_control",
      "generator_model": "linear",
      "mutation": "none",
      "expected_model": "linear",
      "expected_valid": true
    },
    {
      "case_id": "registered_dropout",
      "generator_model": "square_root",
      "mutation": "flagged_dropout",
      "expected_model": "square_root",
      "expected_valid": true
    },
    {
      "case_id": "clock_drift",
      "generator_model": "square_root",
      "mutation": "clock_drift",
      "expected_model": null,
      "expected_valid": false,
      "expected_failed_gate": "clock-calibration"
    },
    {
      "case_id": "mislabeled_length",
      "generator_model": "square_root",
      "mutation": "length_mislabel",
      "expected_model": null,
      "expected_valid": false,
      "expected_failed_gate": "length-calibration"
    },
    {
      "case_id": "large_angle",
      "generator_model": "square_root",
      "mutation": "large_angle",
      "expected_model": null,
      "expected_valid": false,
      "expected_failed_gate": "small-angle-boundary"
    },
    {
      "case_id": "unflagged_outlier",
      "generator_model": "square_root",
      "mutation": "unflagged_outlier",
      "expected_model": null,
      "expected_valid": false,
      "expected_failed_gate": "measurement-stability"
    },
    {
      "case_id": "incomplete_series",
      "generator_model": "square_root",
      "mutation": "incomplete_series",
      "expected_model": null,
      "expected_valid": false,
      "expected_failed_gate": "dataset-completeness"
    },
    {
      "case_id": "excessive_damping",
      "generator_model": "square_root",
      "mutation": "excessive_damping",
      "expected_model": null,
      "expected_valid": false,
      "expected_failed_gate": "damping-boundary"
    }
  ]
}
