{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-machine.local/schemas/addon-manifest.schema.json",
  "title": "Research Machine add-on manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["addon_id", "name", "version", "discipline", "description", "methods", "instrument_adapters", "connectors", "capabilities", "protocol_kinds", "dataset_media_types"],
  "properties": {
    "addon_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "name": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"},
    "version": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"},
    "discipline": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"},
    "description": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"},
    "methods": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["method_id", "title", "description", "required_spec_fields", "maximum_claim_ceiling", "maximum_inference_level", "randomness_control"],
      "allOf": [
        {
          "if": {"properties": {"randomness_control": {"const": "seeded"}}},
          "then": {"properties": {"required_spec_fields": {"contains": {"const": "seed"}}}}
        }
      ],
      "properties": {
        "method_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "title": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"},
        "description": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"},
        "required_spec_fields": {"type": "array", "items": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"}, "uniqueItems": true},
        "maximum_claim_ceiling": {
          "type": "string",
          "pattern": "^\\S(?:.*\\S)?$",
          "not": {
            "pattern": "\\b([Pp]roved|[Cc]onfirmed|[Ee]xplained|[Vv]alidates?|[Vv]alidated)\\b"
          }
        },
        "maximum_inference_level": {"enum": ["computation_only", "descriptive", "association", "design_conditional_effect"]},
        "randomness_control": {"enum": ["deterministic", "seeded"]}
      }
    }},
    "instrument_adapters": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_id", "title", "description", "supported_media_types", "required_config_fields", "optional_config_fields", "authority"],
      "properties": {
        "adapter_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "title": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"},
        "description": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"},
        "supported_media_types": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"}, "uniqueItems": true},
        "required_config_fields": {"type": "array", "items": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"}, "uniqueItems": true},
        "optional_config_fields": {"type": "array", "items": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"}, "uniqueItems": true},
        "authority": {"const": "acquisition_metadata_proposal_only"}
      }
    }},
    "connectors": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["connector_id", "title", "description", "supported_source_types", "required_query_fields", "optional_query_fields", "authority", "scientific_evidence_eligible", "can_register_dataset", "can_clear_custody"],
      "properties": {
        "connector_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "title": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"},
        "description": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"},
        "supported_source_types": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"}, "uniqueItems": true},
        "required_query_fields": {"type": "array", "items": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"}, "uniqueItems": true},
        "optional_query_fields": {"type": "array", "items": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"}, "uniqueItems": true},
        "authority": {"const": "bounded_source_material_proposal_only"},
        "scientific_evidence_eligible": {"const": false},
        "can_register_dataset": {"const": false},
        "can_clear_custody": {"const": false}
      }
    }},
    "capabilities": {"type": "array", "items": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"}, "uniqueItems": true},
    "protocol_kinds": {"type": "array", "items": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"}, "uniqueItems": true},
    "dataset_media_types": {"type": "array", "items": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"}, "uniqueItems": true},
    "documentation": {"type": "string", "pattern": "^(|\\S(?:.*\\S)?)$"}
  }
}
