{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-machine.local/schemas/addon-manifest.schema.json",
  "title": "Research Machine add-on manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["addon_id", "name", "version", "discipline", "description", "methods", "capabilities", "protocol_kinds", "dataset_media_types"],
  "properties": {
    "addon_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "discipline": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "methods": {"type": "array", "items": {"type": "object"}},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "protocol_kinds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dataset_media_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "documentation": {"type": "string"}
  }
}
