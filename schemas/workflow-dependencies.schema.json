{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-machine.local/schemas/workflow-dependencies.schema.json",
  "title": "Pinned analysis workflow dependency manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["family_step_id", "sources"],
  "properties": {
    "family_step_id": {"type": "string", "pattern": "\\S"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_step_id", "execution_directory", "receipt_sha256"],
        "properties": {
          "source_step_id": {"type": "string", "pattern": "\\S"},
          "execution_directory": {"type": "string", "pattern": "\\S"},
          "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
