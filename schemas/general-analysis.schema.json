{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-machine.local/schemas/general-analysis.schema.json",
  "title": "General scientific analysis specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["method", "claim_ceiling"],
  "allOf": [
    {"if": {"properties": {"method": {"enum": ["descriptive_summary", "missingness_report"]}}}, "then": {"required": ["columns"]}},
    {"if": {"properties": {"method": {"const": "pearson_correlation"}}}, "then": {"required": ["x_column", "y_column"]}},
    {"if": {"properties": {"method": {"enum": ["permutation_mean_difference", "independent_mean_difference_ci", "paired_mean_difference_ci"]}}}, "then": {"required": ["outcome_column", "group_column", "groups", "seed"]}},
    {"if": {"properties": {"method": {"const": "independent_mean_difference_ci"}}}, "then": {"required": ["study_design"], "properties": {"study_design": {"const": "independent_groups"}}}},
    {"if": {"properties": {"method": {"const": "adjusted_linear_effect"}}}, "then": {"required": ["outcome_column", "group_column", "groups", "covariate_columns", "unit_column", "study_design"], "properties": {"study_design": {"const": "independent_groups"}, "covariate_columns": {"minItems": 1}}}},
    {"if": {"properties": {"method": {"const": "paired_mean_difference_ci"}}}, "then": {"required": ["study_design", "pair_column"], "properties": {"study_design": {"const": "paired"}}}},
    {"if": {"properties": {"method": {"const": "holm_adjustment"}}}, "then": {"required": ["hypothesis_column", "p_value_column", "family_name", "family_hypothesis_ids", "alpha"]}},
    {"if": {"required": ["unit_column"]}, "then": {"properties": {"method": {"enum": ["permutation_mean_difference", "independent_mean_difference_ci", "adjusted_linear_effect"]}}}}
  ],
  "properties": {
    "method": {"enum": ["descriptive_summary", "missingness_report", "pearson_correlation", "permutation_mean_difference", "independent_mean_difference_ci", "adjusted_linear_effect", "paired_mean_difference_ci", "holm_adjustment"]},
    "analysis_id": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"},
    "columns": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "x_column": {"type": "string", "minLength": 1},
    "y_column": {"type": "string", "minLength": 1},
    "outcome_column": {"type": "string", "minLength": 1},
    "group_column": {"type": "string", "minLength": 1},
    "groups": {"type": "array", "items": {"type": "string", "pattern": "\\S"}, "minItems": 2, "maxItems": 2, "uniqueItems": true},
    "permutations": {"type": "integer", "minimum": 100, "maximum": 1000000},
    "seed": {"type": "integer"},
    "study_design": {"enum": ["independent_groups", "paired"]},
    "pair_column": {"type": "string", "minLength": 1},
    "unit_column": {"type": "string", "pattern": "\\S"},
    "covariate_columns": {"type": "array", "items": {"type": "string", "pattern": "\\S"}, "uniqueItems": true},
    "bootstrap_resamples": {"type": "integer", "minimum": 1000, "maximum": 1000000},
    "confidence_level": {"type": "number", "minimum": 0.8, "exclusiveMaximum": 1},
    "missing_data_policy": {"const": "complete_case"},
    "purpose": {"type": "string"},
    "estimand": {"type": "string", "minLength": 1},
    "contrast_definition": {"type": "string", "minLength": 1},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "parameters": {"type": "object"}
    ,"hypothesis_column": {"type": "string", "pattern": "\\S"}
    ,"p_value_column": {"type": "string", "pattern": "\\S"}
    ,"family_name": {"type": "string", "pattern": "\\S"}
    ,"family_hypothesis_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[^\\s](?:.*[^\\s])?$"}}
    ,"alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
  }
}
