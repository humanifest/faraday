{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-machine.local/schemas/dataset-inventory.schema.json",
  "title": "Dataset inventory report",
  "type": "object",
  "required": [
    "registered_dataset_count",
    "role_counts",
    "synthetic_count",
    "non_synthetic_count",
    "datasets_with_rigor_errors",
    "empty_inventory_notice",
    "interpretation_limit",
    "datasets"
  ],
  "properties": {
    "registered_dataset_count": {"type": "integer", "minimum": 0},
    "role_counts": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "calibration",
          "exploratory",
          "training",
          "confirmatory",
          "replication"
        ]
      },
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "synthetic_count": {"type": "integer", "minimum": 0},
    "non_synthetic_count": {"type": "integer", "minimum": 0},
    "datasets_with_rigor_errors": {"type": "integer", "minimum": 0},
    "empty_inventory_notice": {"type": "string"},
    "interpretation_limit": {"type": "string", "minLength": 1},
    "datasets": {
      "type": "array",
      "items": {"$ref": "#/$defs/dataset"}
    }
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "required": [
        "dataset_id",
        "name",
        "role",
        "synthetic",
        "protocol_id",
        "protocol_present",
        "artifact_count",
        "media_types",
        "source_dataset_ids",
        "source_authority",
        "payload_commitment",
        "observation_access",
        "measurement_custody",
        "workflow_materialization",
        "ethics",
        "rigor_findings",
        "readiness",
        "operational_roots_redacted"
      ],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "role": {
          "enum": [
            "calibration",
            "exploratory",
            "training",
            "confirmatory",
            "replication"
          ]
        },
        "synthetic": {"type": "boolean"},
        "protocol_id": {"type": ["string", "null"]},
        "protocol_present": {"type": "boolean"},
        "artifact_count": {"type": "integer", "minimum": 0},
        "media_types": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "source_dataset_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "source_authority": {"$ref": "#/$defs/source_authority"},
        "payload_commitment": {"$ref": "#/$defs/payload_commitment"},
        "observation_access": {"$ref": "#/$defs/observation_access"},
        "measurement_custody": {"$ref": "#/$defs/measurement_custody"},
        "workflow_materialization": {"$ref": "#/$defs/workflow_materialization"},
        "ethics": {"$ref": "#/$defs/ethics"},
        "rigor_findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/rigor_finding"}
        },
        "readiness": {"$ref": "#/$defs/readiness"},
        "operational_roots_redacted": {"const": true}
      },
      "additionalProperties": false
    },
    "source_authority": {
      "type": "object",
      "required": [
        "status",
        "source_type",
        "source_name",
        "source_record_id",
        "retrieved_or_collected_at",
        "classification_service_checked",
        "source_truth_verified",
        "custody_verified_by_source_authority",
        "evidence_eligibility_conferred",
        "authority_boundary",
        "limitations",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": ["not_recorded", "typed_source_route", "invalid_metadata"]
        },
        "source_type": {
          "enum": [
            "not_recorded",
            "invalid_metadata",
            "registered_experiment",
            "acquisition_addon",
            "scientific_connector",
            "manual_import",
            "external_attestation",
            "synthetic_fixture"
          ]
        },
        "source_name": {"type": "string"},
        "source_record_id": {"type": "string"},
        "retrieved_or_collected_at": {
          "anyOf": [
            {"const": ""},
            {"type": "string", "format": "date-time"}
          ]
        },
        "classification_service_checked": {"type": "boolean"},
        "source_truth_verified": {"const": false},
        "custody_verified_by_source_authority": {"const": false},
        "evidence_eligibility_conferred": {"const": false},
        "authority_boundary": {"type": "string", "minLength": 1},
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "summary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "payload_commitment": {
      "type": "object",
      "required": ["sealed", "sha256", "summary"],
      "properties": {
        "sealed": {"type": "boolean"},
        "sha256": {
          "anyOf": [
            {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        },
        "summary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "observation_access": {
      "type": "object",
      "required": ["status", "service_verified", "summary"],
      "properties": {
        "status": {
          "enum": [
            "synthetic_fixture",
            "protected_observation_bytes_service_verified",
            "protected_observation_bytes_missing_service_verification",
            "declared_hashes_only"
          ]
        },
        "service_verified": {"type": "boolean"},
        "summary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "measurement_custody": {
      "type": "object",
      "required": [
        "status",
        "required_by_protocol",
        "service_verified",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "service_verified",
            "required_missing_service_verification",
            "described_not_service_verified",
            "not_recorded"
          ]
        },
        "required_by_protocol": {"type": "boolean"},
        "service_verified": {"type": "boolean"},
        "summary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "workflow_materialization": {
      "type": "object",
      "required": [
        "status",
        "service_verified",
        "source_receipts_replayed",
        "scientific_evidence_eligible",
        "scientific_interpretation_verified",
        "family_step_id",
        "family_id",
        "source_count",
        "output_sha256",
        "row_count",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": ["not_recorded", "source_receipts_replayed", "invalid_metadata"]
        },
        "service_verified": {"type": "boolean"},
        "source_receipts_replayed": {"type": "boolean"},
        "scientific_evidence_eligible": {"const": false},
        "scientific_interpretation_verified": {"const": false},
        "family_step_id": {"type": "string"},
        "family_id": {"type": "string"},
        "source_count": {"type": "integer", "minimum": 0},
        "output_sha256": {
          "anyOf": [
            {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        },
        "row_count": {"type": "integer", "minimum": 0},
        "summary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "ethics": {
      "type": "object",
      "required": [
        "status",
        "human_subject_protocol",
        "service_checked",
        "conditions_service_verified",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "protocol_missing",
            "not_bound_to_protocol",
            "not_human_subject_protocol",
            "active_service_check",
            "missing_active_service_check",
            "active_service_check_with_conditions_verified",
            "missing_required_ethics_service_verification"
          ]
        },
        "human_subject_protocol": {"type": "boolean"},
        "service_checked": {"type": "boolean"},
        "conditions_service_verified": {"type": "boolean"},
        "summary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "rigor_finding": {
      "type": "object",
      "required": ["code", "severity", "message", "remediation"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["error", "warning", "info"]},
        "message": {"type": "string", "minLength": 1},
        "remediation": {"type": "string"}
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": [
        "status",
        "blocking_finding_codes",
        "warning_finding_codes",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_protected_evidence_dataset",
            "protected_use_blocked_by_rigor",
            "protected_use_has_rigor_warnings",
            "protected_no_dataset_rigor_blockers_detected"
          ]
        },
        "blocking_finding_codes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "warning_finding_codes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "summary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
