{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-machine.local/schemas/evidence-command.schema.json",
  "title": "Evidence recording command",
  "description": "Provider-neutral input contract for claim-scoped evidence.",
  "type": "object",
  "required": [
    "hypothesis_id",
    "direction",
    "summary",
    "uncertainty",
    "scope",
    "higher_level_conclusions_unsupported",
    "validation_tags"
  ],
  "properties": {
    "hypothesis_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": ["string", "null"]},
    "direction": {
      "enum": ["supports", "weakens", "refutes", "inconclusive"]
    },
    "summary": {"$ref": "#/$defs/boundedReportText"},
    "dataset_id": {"type": ["string", "null"], "minLength": 1},
    "run_id": {"type": ["string", "null"], "minLength": 1},
    "analysis_id": {"type": "string"},
    "effect_estimate": {"type": "string"},
    "uncertainty": {"type": "string"},
    "scope": {"type": "string"},
    "controls_passed": {"type": "array", "items": {"type": "string"}},
    "controls_failed": {"type": "array", "items": {"type": "string"}},
    "higher_level_conclusions_unsupported": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "validation_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "source_assessment",
          "calibration",
          "internal_consistency",
          "controlled_benchmark",
          "independent_replication",
          "known_result_reproduction",
          "novel_prediction",
          "empirical_test",
          "causal_estimate"
        ]
      }
    },
    "exploratory": {"type": "boolean", "default": true}
  },
  "additionalProperties": false,
  "$defs": {
    "boundedReportText": {
      "allOf": [
        {"type": "string", "minLength": 1},
        {
          "not": {
            "pattern": "\\b(?:[Pp][Rr][Oo][Vv][Ee][Dd]|[Cc][Oo][Nn][Ff][Ii][Rr][Mm][Ee][Dd]|[Ee][Xx][Pp][Ll][Aa][Ii][Nn][Ee][Dd])\\b"
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"exploratory": {"const": false}}, "required": ["exploratory"]},
      "then": {"required": ["run_id"]},
      "else": {"anyOf": [{"required": ["dataset_id"]}, {"required": ["run_id"]}]}
    }
  ]
}
