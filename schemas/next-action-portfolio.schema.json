{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-machine.local/schemas/next-action-portfolio.schema.json",
  "title": "Balanced research action portfolio",
  "type": "object",
  "required": ["lanes", "candidates"],
  "properties": {
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lane_id", "title"],
        "properties": {
          "lane_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["active", "blocked"], "default": "active"},
          "blocked_on": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true,
            "default": []
          }
        },
        "additionalProperties": false
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "title",
          "distinguishes_hypotheses",
          "expected_discrimination",
          "uncertainty_reduction",
          "cost",
          "burden",
          "safety_risk",
          "ambiguity_risk",
          "rationale",
          "lane_id"
        ],
        "properties": {
          "action_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "distinguishes_hypotheses": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "hypothesis_discrimination_targets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "hypothesis_id",
                "discriminating_observation",
                "expected_if_hypothesis",
                "expected_if_alternative",
                "would_weaken_if"
              ],
              "properties": {
                "hypothesis_id": {"type": "string", "minLength": 1},
                "discriminating_observation": {"type": "string", "minLength": 1},
                "expected_if_hypothesis": {"type": "string", "minLength": 1},
                "expected_if_alternative": {"type": "string", "minLength": 1},
                "would_weaken_if": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            },
            "default": []
          },
          "information_targets": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true,
            "default": []
          },
          "expected_discrimination": {"type": "number", "minimum": 0, "maximum": 1},
          "uncertainty_reduction": {"type": "number", "minimum": 0, "maximum": 1},
          "cost": {"type": "number", "minimum": 0, "maximum": 1},
          "burden": {"type": "number", "minimum": 0, "maximum": 1},
          "safety_risk": {"type": "number", "minimum": 0, "maximum": 1},
          "ambiguity_risk": {"type": "number", "minimum": 0, "maximum": 1},
          "rationale": {"type": "string", "minLength": 1},
          "prerequisites_met": {"type": "boolean", "default": true},
          "safety_approved": {"type": "boolean", "default": true},
          "lane_id": {"type": "string", "minLength": 1},
          "depends_on": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true,
            "default": []
          },
          "manipulated_factors": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true,
            "default": []
          },
          "factorial_or_crossover_design": {"type": "boolean", "default": false},
          "factor_interpretability_plan": {"type": "string", "default": ""},
          "metadata": {"type": "object"}
        },
        "anyOf": [
          {
            "required": ["hypothesis_discrimination_targets"],
            "properties": {
              "distinguishes_hypotheses": {"minItems": 1},
              "hypothesis_discrimination_targets": {"minItems": 1}
            }
          },
          {"required": ["information_targets"], "properties": {"information_targets": {"minItems": 1}}}
        ],
        "allOf": [
          {
            "if": {
              "required": ["distinguishes_hypotheses"],
              "properties": {"distinguishes_hypotheses": {"minItems": 1}}
            },
            "then": {
              "required": ["hypothesis_discrimination_targets"],
              "properties": {"hypothesis_discrimination_targets": {"minItems": 1}}
            }
          },
          {
            "if": {
              "required": ["distinguishes_hypotheses"],
              "properties": {"distinguishes_hypotheses": {"maxItems": 0}}
            },
            "then": {
              "properties": {"hypothesis_discrimination_targets": {"maxItems": 0}}
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "completed_action_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true,
      "default": []
    },
    "weights": {
      "type": "object",
      "properties": {
        "expected_discrimination": {"type": "number", "minimum": 0},
        "uncertainty_reduction": {"type": "number", "minimum": 0},
        "cost": {"type": "number", "minimum": 0},
        "burden": {"type": "number", "minimum": 0},
        "safety_risk": {"type": "number", "minimum": 0},
        "ambiguity_risk": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
