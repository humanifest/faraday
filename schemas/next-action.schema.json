{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-machine.local/schemas/next-action.schema.json",
  "title": "Next research action selection",
  "type": "object",
  "$defs": {
    "auditPrerequisiteContract": {
      "type": "object",
      "required": ["contract_version", "action_class", "subjects", "required_audits", "evaluator_exposure_statement", "nonadvancing_information_statement", "limitations", "conclusion_ceiling"],
      "properties": {
        "contract_version": {"const": 1},
        "action_class": {"enum": ["candidate_advancing", "exposed_evaluator_development", "nonadvancing_information"]},
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["subject_role", "subject_id", "artifact_locator", "artifact_sha256"],
            "properties": {
              "subject_role": {"enum": ["candidate", "implementation"]},
              "subject_id": {"type": "string", "minLength": 1},
              "artifact_locator": {"type": "string", "minLength": 1},
              "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "required_audits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["audit_id", "artifact_role", "artifact_locator", "artifact_sha256", "audited_subject_role", "audited_subject_id", "audited_subject_sha256", "verdict", "scope", "auditor_identity", "audited_at", "limitations", "supporting_artifacts"],
            "properties": {
              "audit_id": {"type": "string", "minLength": 1},
              "artifact_role": {"type": "string", "minLength": 1},
              "artifact_locator": {"type": "string", "minLength": 1},
              "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "audited_subject_role": {"enum": ["candidate", "implementation"]},
              "audited_subject_id": {"type": "string", "minLength": 1},
              "audited_subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "verdict": {"enum": ["favorable", "pending", "adverse"]},
              "scope": {"type": "string", "minLength": 1},
              "auditor_identity": {"type": "string", "minLength": 1},
              "audited_at": {"type": "string", "format": "date-time"},
              "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "supporting_artifacts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["artifact_role", "artifact_locator", "artifact_sha256"],
                  "properties": {
                    "artifact_role": {"type": "string", "minLength": 1},
                    "artifact_locator": {"type": "string", "minLength": 1},
                    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "evaluator_exposure_statement": {"type": "string"},
        "nonadvancing_information_statement": {"type": "string"},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "conclusion_ceiling": {"const": "Workflow eligibility only; does not establish audit truth, auditor identity or independence, scientific validity, or evidence eligibility."}
      },
      "allOf": [
        {
          "if": {"properties": {"action_class": {"const": "candidate_advancing"}}, "required": ["action_class"]},
          "then": {"properties": {"subjects": {"minItems": 1}, "required_audits": {"minItems": 1}, "evaluator_exposure_statement": {"const": ""}, "nonadvancing_information_statement": {"const": ""}}}
        },
        {
          "if": {"properties": {"action_class": {"const": "exposed_evaluator_development"}}, "required": ["action_class"]},
          "then": {"properties": {"subjects": {"maxItems": 0}, "required_audits": {"maxItems": 0}, "evaluator_exposure_statement": {"minLength": 1}, "nonadvancing_information_statement": {"const": ""}}}
        },
        {
          "if": {"properties": {"action_class": {"const": "nonadvancing_information"}}, "required": ["action_class"]},
          "then": {"properties": {"subjects": {"maxItems": 0}, "required_audits": {"maxItems": 0}, "evaluator_exposure_statement": {"const": ""}, "nonadvancing_information_statement": {"minLength": 1}}}
        }
      ],
      "additionalProperties": false
    }
  },
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action_id", "title", "distinguishes_hypotheses", "expected_discrimination", "uncertainty_reduction", "cost", "duration", "burden", "safety_risk", "ambiguity_risk", "rationale", "prerequisite_evidence_refs", "safety_review_refs", "audit_prerequisite_contract"],
        "properties": {
          "action_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "distinguishes_hypotheses": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "hypothesis_discrimination_targets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["hypothesis_id", "discriminating_observation", "expected_if_hypothesis", "expected_if_alternative", "would_weaken_if", "competing_model_ref"],
              "properties": {
                "hypothesis_id": {"type": "string", "minLength": 1},
                "discriminating_observation": {"type": "string", "minLength": 1},
                "expected_if_hypothesis": {"type": "string", "minLength": 1},
                "expected_if_alternative": {"type": "string", "minLength": 1},
                "would_weaken_if": {"type": "string", "minLength": 1},
                "competing_model_ref": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            },
            "default": []
          },
          "information_targets": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "default": []},
          "expected_discrimination": {"type": "number", "minimum": 0, "maximum": 1},
          "uncertainty_reduction": {"type": "number", "minimum": 0, "maximum": 1},
          "cost": {"type": "number", "minimum": 0, "maximum": 1},
          "duration": {"type": "number", "minimum": 0, "maximum": 1},
          "burden": {"type": "number", "minimum": 0, "maximum": 1},
          "safety_risk": {"type": "number", "minimum": 0, "maximum": 1},
          "ambiguity_risk": {"type": "number", "minimum": 0, "maximum": 1},
          "rationale": {"type": "string", "minLength": 1},
          "prerequisites_met": {"type": "boolean", "default": true},
          "safety_approved": {"type": "boolean", "default": true},
          "prerequisite_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "safety_review_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "lane_id": {"type": "string", "minLength": 1, "default": "default"},
          "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "maxItems": 0, "default": []},
          "manipulated_factors": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "default": []},
          "factorial_or_crossover_design": {"type": "boolean", "default": false},
          "factor_interpretability_plan": {"type": "string", "default": ""},
          "metadata": {"type": "object"},
          "audit_prerequisite_contract": {"$ref": "#/$defs/auditPrerequisiteContract"}
        },
        "anyOf": [
          {
            "required": ["hypothesis_discrimination_targets"],
            "properties": {
              "distinguishes_hypotheses": {"minItems": 1},
              "hypothesis_discrimination_targets": {"minItems": 1}
            }
          },
          {"required": ["information_targets"], "properties": {"information_targets": {"minItems": 1}}}
        ],
        "allOf": [
          {
            "if": {
              "required": ["distinguishes_hypotheses"],
              "properties": {"distinguishes_hypotheses": {"minItems": 1}}
            },
            "then": {
              "required": ["hypothesis_discrimination_targets"],
              "properties": {"hypothesis_discrimination_targets": {"minItems": 1}}
            }
          },
          {
            "if": {
              "required": ["distinguishes_hypotheses"],
              "properties": {"distinguishes_hypotheses": {"maxItems": 0}}
            },
            "then": {
              "properties": {
                "expected_discrimination": {"const": 0},
                "hypothesis_discrimination_targets": {"maxItems": 0}
              }
            }
          },
          {
            "if": {
              "properties": {
                "audit_prerequisite_contract": {
                  "properties": {"action_class": {"enum": ["exposed_evaluator_development", "nonadvancing_information"]}}
                }
              }
            },
            "then": {
              "properties": {
                "distinguishes_hypotheses": {"maxItems": 0},
                "expected_discrimination": {"const": 0},
                "hypothesis_discrimination_targets": {"maxItems": 0}
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "weights": {
      "type": "object",
      "properties": {
        "expected_discrimination": {"type": "number", "minimum": 0},
        "uncertainty_reduction": {"type": "number", "minimum": 0},
        "cost": {"type": "number", "minimum": 0},
        "duration": {"type": "number", "minimum": 0},
        "burden": {"type": "number", "minimum": 0},
        "safety_risk": {"type": "number", "minimum": 0},
        "ambiguity_risk": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
