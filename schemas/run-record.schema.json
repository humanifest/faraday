{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-machine.local/schemas/run-record.schema.json",
  "title": "Research run record",
  "type": "object",
  "required": ["protocol_id", "started_at", "completed_at", "analysis_code_hash", "environment_hash", "output_artifacts"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "protocol_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "analysis_code_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "random_seed_reveal": {"type": ["string", "null"], "minLength": 1},
    "dataset_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "output_artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["locator", "sha256"],
        "properties": {
          "locator": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": ["integer", "null"], "minimum": 0},
          "media_type": {"type": "string"},
          "metadata": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "quality_gates": {
      "type": "array",
      "items": {
        "type": "object", "required": ["gate_id", "status", "summary"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "warning", "skipped"]},
          "summary": {"$ref": "#/$defs/nonEmptyBoundedReportText"},
          "required": {"type": "boolean", "default": true},
          "details": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "summary": {"$ref": "#/$defs/boundedReportText"},
    "synthetic": {"type": "boolean", "default": false},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "boundedReportText": {
      "allOf": [
        {"type": "string"},
        {
          "not": {
            "pattern": "\\b(?:[Pp][Rr][Oo][Vv][Ee][Dd]|[Cc][Oo][Nn][Ff][Ii][Rr][Mm][Ee][Dd]|[Ee][Xx][Pp][Ll][Aa][Ii][Nn][Ee][Dd]|[Vv][Aa][Ll][Ii][Dd][Aa][Tt][Ee][Ss]?|[Vv][Aa][Ll][Ii][Dd][Aa][Tt][Ee][Dd])\\b"
          }
        },
        {
          "not": {
            "pattern": "\\b(?:[Ee][Ss][Tt][Aa][Bb][Ll][Ii][Ss][Hh]|[Ee][Ss][Tt][Aa][Bb][Ll][Ii][Ss][Hh][Ee][Ss]|[Ee][Ss][Tt][Aa][Bb][Ll][Ii][Ss][Hh][Ee][Dd]|[Ff][Ii][Nn][Dd]|[Ff][Ii][Nn][Dd][Ss]|[Ff][Oo][Uu][Nn][Dd]|[Dd][Ee][Tt][Ee][Rr][Mm][Ii][Nn][Ee]|[Dd][Ee][Tt][Ee][Rr][Mm][Ii][Nn][Ee][Ss]|[Dd][Ee][Tt][Ee][Rr][Mm][Ii][Nn][Ee][Dd]|[Ss][Hh][Oo][Ww]|[Ss][Hh][Oo][Ww][Ss]|[Ss][Hh][Oo][Ww][Ee][Dd]|[Dd][Ee][Mm][Oo][Nn][Ss][Tt][Rr][Aa][Tt][Ee]|[Dd][Ee][Mm][Oo][Nn][Ss][Tt][Rr][Aa][Tt][Ee][Ss]|[Dd][Ee][Mm][Oo][Nn][Ss][Tt][Rr][Aa][Tt][Ee][Dd])\\b(?:\\s+\\w+){0,6}\\s+\\b(?:[Ll][Ee][Gg][Aa][Ll] [Cc][Hh][Aa][Rr][Aa][Cc][Tt][Ee][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Ll][Ee][Gg][Aa][Ll] [Rr][Ee][Ss][Pp][Oo][Nn][Ss][Ii][Bb][Ii][Ll][Ii][Tt][Yy]|[Ll][Ee][Gg][Aa][Ll] [Ll][Ii][Aa][Bb][Ii][Ll][Ii][Tt][Yy]|[Cc][Uu][Ll][Pp][Aa][Bb][Ii][Ll][Ii][Tt][Yy]|[Ll][Ii][Aa][Bb][Ii][Ll][Ii][Tt][Yy]|[Gg][Uu][Ii][Ll][Tt]|[Nn][Ee][Gg][Ll][Ii][Gg][Ee][Nn][Cc][Ee]|[Ff][Rr][Aa][Uu][Dd][Uu][Ll][Ee][Nn][Tt] [Ii][Nn][Tt][Ee][Nn][Tt]|[Cc][Rr][Ii][Mm][Ii][Nn][Aa][Ll] [Ii][Nn][Tt][Ee][Nn][Tt]|[Ii][Nn][Tt][Ee][Nn][Tt][Ii][Oo][Nn][Aa][Ll] [Ww][Rr][Oo][Nn][Gg][Dd][Oo][Ii][Nn][Gg])\\b|\\b(?:[Ii][Ss]|[Aa][Rr][Ee]|[Ww][Aa][Ss]|[Ww][Ee][Rr][Ee])\\s+(?:[Ll][Ee][Gg][Aa][Ll][Ll][Yy] [Rr][Ee][Ss][Pp][Oo][Nn][Ss][Ii][Bb][Ll][Ee]|[Ll][Ii][Aa][Bb][Ll][Ee]|[Gg][Uu][Ii][Ll][Tt][Yy]|[Nn][Ee][Gg][Ll][Ii][Gg][Ee][Nn][Tt])\\b|[Cc][Oo][Mm][Mm][Ii][Tt][Tt][Ee][Dd] [Ff][Rr][Aa][Uu][Dd]"
          }
        }
      ]
    },
    "nonEmptyBoundedReportText": {
      "allOf": [
        {"type": "string", "minLength": 1},
        {
          "not": {
            "pattern": "\\b(?:[Pp][Rr][Oo][Vv][Ee][Dd]|[Cc][Oo][Nn][Ff][Ii][Rr][Mm][Ee][Dd]|[Ee][Xx][Pp][Ll][Aa][Ii][Nn][Ee][Dd]|[Vv][Aa][Ll][Ii][Dd][Aa][Tt][Ee][Ss]?|[Vv][Aa][Ll][Ii][Dd][Aa][Tt][Ee][Dd])\\b"
          }
        },
        {
          "not": {
            "pattern": "\\b(?:[Ee][Ss][Tt][Aa][Bb][Ll][Ii][Ss][Hh]|[Ee][Ss][Tt][Aa][Bb][Ll][Ii][Ss][Hh][Ee][Ss]|[Ee][Ss][Tt][Aa][Bb][Ll][Ii][Ss][Hh][Ee][Dd]|[Ff][Ii][Nn][Dd]|[Ff][Ii][Nn][Dd][Ss]|[Ff][Oo][Uu][Nn][Dd]|[Dd][Ee][Tt][Ee][Rr][Mm][Ii][Nn][Ee]|[Dd][Ee][Tt][Ee][Rr][Mm][Ii][Nn][Ee][Ss]|[Dd][Ee][Tt][Ee][Rr][Mm][Ii][Nn][Ee][Dd]|[Ss][Hh][Oo][Ww]|[Ss][Hh][Oo][Ww][Ss]|[Ss][Hh][Oo][Ww][Ee][Dd]|[Dd][Ee][Mm][Oo][Nn][Ss][Tt][Rr][Aa][Tt][Ee]|[Dd][Ee][Mm][Oo][Nn][Ss][Tt][Rr][Aa][Tt][Ee][Ss]|[Dd][Ee][Mm][Oo][Nn][Ss][Tt][Rr][Aa][Tt][Ee][Dd])\\b(?:\\s+\\w+){0,6}\\s+\\b(?:[Ll][Ee][Gg][Aa][Ll] [Cc][Hh][Aa][Rr][Aa][Cc][Tt][Ee][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Ll][Ee][Gg][Aa][Ll] [Rr][Ee][Ss][Pp][Oo][Nn][Ss][Ii][Bb][Ii][Ll][Ii][Tt][Yy]|[Ll][Ee][Gg][Aa][Ll] [Ll][Ii][Aa][Bb][Ii][Ll][Ii][Tt][Yy]|[Cc][Uu][Ll][Pp][Aa][Bb][Ii][Ll][Ii][Tt][Yy]|[Ll][Ii][Aa][Bb][Ii][Ll][Ii][Tt][Yy]|[Gg][Uu][Ii][Ll][Tt]|[Nn][Ee][Gg][Ll][Ii][Gg][Ee][Nn][Cc][Ee]|[Ff][Rr][Aa][Uu][Dd][Uu][Ll][Ee][Nn][Tt] [Ii][Nn][Tt][Ee][Nn][Tt]|[Cc][Rr][Ii][Mm][Ii][Nn][Aa][Ll] [Ii][Nn][Tt][Ee][Nn][Tt]|[Ii][Nn][Tt][Ee][Nn][Tt][Ii][Oo][Nn][Aa][Ll] [Ww][Rr][Oo][Nn][Gg][Dd][Oo][Ii][Nn][Gg])\\b|\\b(?:[Ii][Ss]|[Aa][Rr][Ee]|[Ww][Aa][Ss]|[Ww][Ee][Rr][Ee])\\s+(?:[Ll][Ee][Gg][Aa][Ll][Ll][Yy] [Rr][Ee][Ss][Pp][Oo][Nn][Ss][Ii][Bb][Ll][Ee]|[Ll][Ii][Aa][Bb][Ll][Ee]|[Gg][Uu][Ii][Ll][Tt][Yy]|[Nn][Ee][Gg][Ll][Ii][Gg][Ee][Nn][Tt])\\b|[Cc][Oo][Mm][Mm][Ii][Tt][Tt][Ee][Dd] [Ff][Rr][Aa][Uu][Dd]"
          }
        }
      ]
    }
  }
}
