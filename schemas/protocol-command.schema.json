    "conclusionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_hypothesis_id", "decision_rule", "smallest_effect_size_of_interest", "effect_scale", "effect_unit", "population", "setting", "time_window", "non_supporting_direction", "permitted_claim_level", "higher_level_conclusions_unsupported"],
      "properties": {
        "primary_hypothesis_id": {"type": "string", "pattern": "\\S"},
