{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-machine.local/schemas/protocol-command.schema.json",
  "title": "Research protocol command",
  "description": "A domain-neutral protocol. Kind-specific freeze gates are enforced by the application service.",
  "type": "object",
  "required": [
    "experiment_id", "title", "analysis_mode", "hypotheses_tested",
    "primary_outcome", "protocol_kind", "methodology", "quality_requirements",
    "controls", "sample_size_or_stopping_rule", "expected_outputs",
    "success_conditions", "failure_conditions", "safety_constraints",
    "analysis_code_hash"
  ],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "analysis_mode": {"enum": ["exploratory", "confirmatory", "replication"]},
    "protocol_kind": {"enum": ["observational", "experimental", "computational", "formal", "literature", "synthesis"]},
    "hypotheses_tested": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "primary_outcome": {"type": "string", "minLength": 1},
    "methodology": {"type": "string", "minLength": 1},
    "inputs_required": {"type": "array", "items": {"type": "string"}},
    "quality_requirements": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "controls": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "expected_outputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "success_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "environment_requirements": {"type": "array", "items": {"type": "string"}},
    "secondary_outcomes": {"type": "array", "items": {"type": "string"}},
    "independent_variables": {"type": "array", "items": {"type": "string"}},
    "randomization_plan": {"type": "string"},
    "blinding_plan": {"type": "string"},
    "sampling_unit": {"type": "string"},
    "sample_size_or_stopping_rule": {"type": "string", "minLength": 1},
    "inclusion_rules": {"type": "array", "items": {"type": "string"}},
    "exclusion_rules": {"type": "array", "items": {"type": "string"}},
    "sensor_requirements": {"type": "array", "items": {"type": "string"}},
    "calibration_requirements": {"type": "array", "items": {"type": "string"}},
    "clock_accuracy_requirement": {"type": "string"},
    "preprocessing_pipeline": {"type": "string"},
    "statistical_model": {"type": "string"},
    "control_windows": {"type": "array", "items": {"type": "string"}},
    "multiple_testing_policy": {"type": "string"},
    "missing_data_policy": {"type": "string"},
    "failure_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "safety_constraints": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "analysis_code_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "external_anchor": {"type": ["string", "null"]},
    "random_seed_commitment": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
