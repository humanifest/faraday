        "outcome": {"type": "string", "pattern": "\\S"},
        "measurement_id": {"type": "string", "pattern": "\\S"}
      }
    },
    "analysisStepContract": {
      "type": "object", "additionalProperties": false,
      "required": ["step_id", "role", "method", "specification_sha256", "implementation_sha256", "depends_on"],
      "properties": {
        "step_id": {"type": "string", "pattern": "\\S"},
