{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-machine.local/schemas/protocol-command.schema.json",
  "title": "Research protocol command",
  "description": "A domain-neutral protocol. Kind-specific freeze gates are enforced by the application service.",
  "type": "object",
  "$defs": {
    "runtimePreflightRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_sha256", "probe_id", "interpreter_path", "kernel_name", "working_directory"],
      "properties": {
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "probe_id": {"const": "research-machine-runtime-preflight-v1"},
        "interpreter_path": {"type": "string", "pattern": "^/"},
        "kernel_name": {"type": "string", "pattern": "\\S"},
        "working_directory": {"type": "string", "pattern": "^/"}
      }
    },
    "canonicalText": {
      "type": "string",
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "boundedReportText": {
      "allOf": [
        {"type": "string", "pattern": "\\S"},
        {
          "not": {
            "pattern": "\\b(?:[Pp][Rr][Oo][Vv][Ee][Dd]|[Cc][Oo][Nn][Ff][Ii][Rr][Mm][Ee][Dd]|[Ee][Xx][Pp][Ll][Aa][Ii][Nn][Ee][Dd]|[Vv][Aa][Ll][Ii][Dd][Aa][Tt][Ee][Ss]?|[Vv][Aa][Ll][Ii][Dd][Aa][Tt][Ee][Dd])\\b"
          }
        }
      ]
    },
    "causalIdentification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "exposure", "outcome", "proposed_adjustment_set", "assignment_type", "assumptions", "causal_estimand"],
      "properties": {
        "nodes": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "observed"],
            "properties": {
              "id": {"type": "string", "pattern": "\\S"},
              "observed": {"type": "boolean"}
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["cause", "effect"],
            "properties": {
              "cause": {"type": "string", "pattern": "\\S"},
              "effect": {"type": "string", "pattern": "\\S"}
            }
          }
        },
        "exposure": {"type": "string", "pattern": "\\S"},
        "outcome": {"type": "string", "pattern": "\\S"},
        "proposed_adjustment_set": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "\\S"}
        },
        "assignment_type": {"enum": ["observational", "randomized"]},
        "causal_estimand": {
          "type": "object", "additionalProperties": false,
          "required": ["target_hypothesis_id", "description", "population", "exposure_strategies", "outcome_variable", "time_zero", "outcome_time", "contrast", "summary_measure", "intercurrent_events_policy"],
          "properties": {
            "target_hypothesis_id": {"type": "string", "pattern": "\\S"},
            "description": {"type": "string", "pattern": "\\S"},
            "population": {"type": "string", "pattern": "\\S"},
            "exposure_strategies": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
            "outcome_variable": {"type": "string", "pattern": "\\S"},
            "time_zero": {"type": "string", "pattern": "\\S"},
            "outcome_time": {"type": "string", "pattern": "\\S"},
            "contrast": {"type": "string", "pattern": "\\S"},
            "summary_measure": {"type": "string", "pattern": "\\S"},
            "intercurrent_events_policy": {"type": "string", "pattern": "\\S"}
          }
        },
        "assumptions": {
          "type": "array", "minItems": 7, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["category", "statement", "assessment_kind", "assessment_plan", "failure_response", "assessment_gate_id"],
            "properties": {
              "category": {"enum": ["allocation_integrity", "consistency", "exchangeability", "interference", "measurement_validity", "positivity", "selection_bias", "temporal_order"]},
              "statement": {"type": "string", "pattern": "\\S"},
              "assessment_kind": {"enum": ["empirical_diagnostic", "design_record_review", "external_validation", "substantive_judgment"]},
              "assessment_plan": {"type": "string", "pattern": "\\S"},
              "failure_response": {"type": "string", "pattern": "\\S"},
              "assessment_gate_id": {"type": "string", "pattern": "\\S"}
            }
          }
        }
      }
    },
    "controlWitnessContract": {
      "type": "object", "additionalProperties": false,
      "required": ["intervention_id", "measurement_id", "comparator", "reference_value"],
      "properties": {
        "intervention_id": {"$ref": "#/$defs/canonicalText"},
        "measurement_id": {"$ref": "#/$defs/canonicalText"},
        "comparator": {"enum": ["eq", "ne", "lt", "lte", "gt", "gte"]},
        "reference_value": {"type": "number"}
      }
    },
    "controlDefinition": {
      "type": "object", "additionalProperties": false,
      "required": ["control_id", "registered_control", "family", "purpose", "expected_behavior", "evaluation_gate_id"],
      "properties": {
        "control_id": {"type": "string", "minLength": 1},
        "registered_control": {"type": "string", "minLength": 1},
        "family": {"enum": ["positive", "negative", "sham", "replay", "random_time", "adversarial", "apparatus_only", "reference", "other"]},
        "purpose": {"type": "string", "minLength": 1},
        "expected_behavior": {"type": "string", "minLength": 1},
        "evaluation_gate_id": {"type": "string", "minLength": 1},
        "witness_contract": {"$ref": "#/$defs/controlWitnessContract"}
      }
    },
    "calibrationCriterion": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_id", "calibration_id", "quantity", "unit", "rationale"],
      "properties": {
        "criterion_id": {"$ref": "#/$defs/canonicalText"},
        "calibration_id": {"$ref": "#/$defs/canonicalText"},
        "quantity": {"$ref": "#/$defs/canonicalText"},
        "unit": {"$ref": "#/$defs/canonicalText"},
        "rationale": {"$ref": "#/$defs/canonicalText"},
        "lower_bound": {"type": ["number", "null"]},
        "upper_bound": {"type": ["number", "null"]},
        "component_bounds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component_id", "quantity", "unit", "lower_bound", "upper_bound"],
            "properties": {
              "component_id": {"$ref": "#/$defs/canonicalText"},
              "quantity": {"$ref": "#/$defs/canonicalText"},
              "unit": {"$ref": "#/$defs/canonicalText"},
              "lower_bound": {"type": ["number", "null"]},
              "upper_bound": {"type": ["number", "null"]}
            },
            "anyOf": [
              {"properties": {"lower_bound": {"type": "number"}}},
              {"properties": {"upper_bound": {"type": "number"}}}
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {"required": ["component_bounds"]},
          "then": {
            "properties": {
              "lower_bound": {"type": "null"},
              "upper_bound": {"type": "null"}
            }
          },
          "else": {
            "anyOf": [
              {"required": ["lower_bound"], "properties": {"lower_bound": {"type": "number"}}},
              {"required": ["upper_bound"], "properties": {"upper_bound": {"type": "number"}}}
            ]
          }
        }
      ]
    },
    "measurementValidityCheck": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "measurement_id", "evidence_type", "validity_claim", "assessment_plan", "acceptance_criterion", "failure_response", "assessment_gate_id"],
      "properties": {
        "check_id": {"type": "string", "pattern": "\\S"},
        "measurement_id": {"type": "string", "pattern": "\\S"},
        "evidence_type": {"enum": ["criterion", "convergent", "discriminant", "known_groups", "test_retest", "inter_rater", "content", "calibration", "other"]},
        "validity_claim": {"type": "string", "pattern": "\\S"},
        "assessment_plan": {"type": "string", "pattern": "\\S"},
        "acceptance_criterion": {"type": "string", "pattern": "\\S"},
        "failure_response": {"type": "string", "pattern": "\\S"},
        "assessment_gate_id": {"type": "string", "pattern": "\\S"}
      }
    },
    "namedComponentContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "measurement_id", "component_ids", "selected_component_ids", "relabeled_component_ids", "relabeling_control_id", "evaluation_gate_id"],
      "properties": {
        "contract_id": {"type": "string", "pattern": "\\S"},
        "measurement_id": {"type": "string", "pattern": "\\S"},
        "component_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
        "selected_component_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
        "relabeled_component_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
        "relabeling_control_id": {"type": "string", "pattern": "\\S"},
        "evaluation_gate_id": {"type": "string", "pattern": "\\S"}
      }
    },
    "mathematicalPredicateContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "object_id",
        "object_kind",
        "domain",
        "codomain",
        "quotient",
        "construction",
        "predicate",
        "predicate_definition",
        "adversarial_control_id",
        "evaluation_gate_id"
      ],
      "properties": {
        "contract_id": {"$ref": "#/$defs/canonicalText"},
        "object_id": {"$ref": "#/$defs/canonicalText"},
        "object_kind": {
          "enum": [
            "bilinear_form",
            "custom",
            "linear_map",
            "linear_operator",
            "nonlinear_map",
            "nonlinear_operator",
            "quadratic_form",
            "quotient_map",
            "residual",
            "state_space",
            "tensor"
          ]
        },
        "domain": {"$ref": "#/$defs/canonicalText"},
        "codomain": {"$ref": "#/$defs/canonicalText"},
        "quotient": {"$ref": "#/$defs/canonicalText"},
        "construction": {"$ref": "#/$defs/canonicalText"},
        "predicate": {
          "enum": [
            "bijective",
            "closed",
            "conserved",
            "custom",
            "equivalent",
            "injective",
            "invertible",
            "nonnegative",
            "nullity",
            "positive_definite",
            "positive_semidefinite",
            "rank",
            "surjective",
            "tangent"
          ]
        },
        "predicate_definition": {"$ref": "#/$defs/canonicalText"},
        "adversarial_control_id": {"$ref": "#/$defs/canonicalText"},
        "evaluation_gate_id": {"$ref": "#/$defs/canonicalText"},
        "derived_from_object_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalText"}
        },
        "comparison_object_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalText"}
        },
        "equivalence_conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalText"}
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["predicate"],
            "properties": {"predicate": {"const": "equivalent"}}
          },
          "then": {
            "required": ["comparison_object_ids", "equivalence_conditions"],
            "properties": {
              "comparison_object_ids": {"minItems": 1, "maxItems": 1},
              "equivalence_conditions": {"minItems": 1}
            }
          },
          "else": {
            "properties": {
              "comparison_object_ids": {"maxItems": 0},
              "equivalence_conditions": {"maxItems": 0}
            }
          }
        }
      ]
    },
    "dualityReconstructionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "predicate_contract_id",
        "primal_space_id",
        "dual_space_id",
        "pairing_id",
        "pairing_definition",
        "reconstruction_map_id",
        "reconstruction_definition",
        "reconstruction_specification_sha256",
        "basis_specification_sha256",
        "quadrature_specification_sha256",
        "source_status",
        "source_refs",
        "forbidden_dependency_object_ids",
        "circularity_control_id",
        "evaluation_gate_id"
      ],
      "properties": {
        "contract_id": {"$ref": "#/$defs/canonicalText"},
        "predicate_contract_id": {"$ref": "#/$defs/canonicalText"},
        "primal_space_id": {"$ref": "#/$defs/canonicalText"},
        "dual_space_id": {"$ref": "#/$defs/canonicalText"},
        "pairing_id": {"$ref": "#/$defs/canonicalText"},
        "pairing_definition": {"$ref": "#/$defs/canonicalText"},
        "reconstruction_map_id": {"$ref": "#/$defs/canonicalText"},
        "reconstruction_definition": {"$ref": "#/$defs/canonicalText"},
        "reconstruction_specification_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "basis_specification_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "quadrature_specification_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_status": {
          "enum": ["source_derived", "engineering_assumption", "mixed"]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalText"}
        },
        "forbidden_dependency_object_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalText"}
        },
        "circularity_control_id": {"$ref": "#/$defs/canonicalText"},
        "evaluation_gate_id": {"$ref": "#/$defs/canonicalText"},
        "transfer_map_id": {
          "anyOf": [
            {"const": ""},
            {"$ref": "#/$defs/canonicalText"}
          ]
        },
        "transfer_specification_sha256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$"
        }
      },
      "dependentRequired": {
        "transfer_map_id": ["transfer_specification_sha256"],
        "transfer_specification_sha256": ["transfer_map_id"]
      }
    },
    "reconstructionFamilyStabilityContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "duality_reconstruction_contract_id",
        "resolution_family_id",
        "resolution_ids",
        "primal_norm_id",
        "dual_norm_id",
        "norm_specification_sha256",
        "stability_statistic",
        "stability_comparator",
        "stability_threshold",
        "stability_specification_sha256",
        "family_specification_sha256",
        "test_family_span_id",
        "test_family_specification_sha256",
        "forward_cross_projection_id",
        "reverse_cross_projection_id",
        "cross_projection_specification_sha256",
        "cross_projection_error_threshold",
        "transfer_map_ids",
        "transfer_specification_sha256",
        "adverse_family_control_id",
        "adverse_family_specification_sha256",
        "evaluation_gate_id"
      ],
      "properties": {
        "contract_id": {"$ref": "#/$defs/canonicalText"},
        "duality_reconstruction_contract_id": {"$ref": "#/$defs/canonicalText"},
        "resolution_family_id": {"$ref": "#/$defs/canonicalText"},
        "resolution_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalText"}
        },
        "primal_norm_id": {"$ref": "#/$defs/canonicalText"},
        "dual_norm_id": {"$ref": "#/$defs/canonicalText"},
        "norm_specification_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stability_statistic": {
          "enum": ["inf_sup_constant", "inverse_operator_norm", "smallest_singular_value"]
        },
        "stability_comparator": {
          "enum": ["greater_than_or_equal", "less_than_or_equal"]
        },
        "stability_threshold": {"type": "number", "minimum": 0},
        "stability_specification_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "family_specification_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "test_family_span_id": {"$ref": "#/$defs/canonicalText"},
        "test_family_specification_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "forward_cross_projection_id": {"$ref": "#/$defs/canonicalText"},
        "reverse_cross_projection_id": {"$ref": "#/$defs/canonicalText"},
        "cross_projection_specification_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cross_projection_error_threshold": {"type": "number", "minimum": 0},
        "transfer_map_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalText"}
        },
        "transfer_specification_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "adverse_family_control_id": {"$ref": "#/$defs/canonicalText"},
        "adverse_family_specification_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evaluation_gate_id": {"$ref": "#/$defs/canonicalText"}
      }
    },
    "analysisImplementationMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "role", "sha256", "size_bytes"],
      "properties": {
        "locator": {"$ref": "#/$defs/canonicalText"},
        "role": {"$ref": "#/$defs/canonicalText"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "analysisImplementationBundleContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "analysis_code_hash",
        "entrypoint_locators",
        "members",
        "bundle_sha256",
        "closure_method",
        "closure_specification_sha256",
        "closure_limitations",
        "allowed_external_dependency_ids",
        "external_dependency_specification_sha256",
        "observed_member_receipt_specification_sha256",
        "adverse_omission_control_id",
        "evaluation_gate_id"
      ],
      "properties": {
        "contract_id": {"$ref": "#/$defs/canonicalText"},
        "analysis_code_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "entrypoint_locators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalText"}
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/analysisImplementationMember"}
        },
        "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "closure_method": {
          "enum": ["runtime_trace", "static_import_graph", "static_plus_runtime_trace"]
        },
        "closure_specification_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "closure_limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalText"}
        },
        "allowed_external_dependency_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalText"}
        },
        "external_dependency_specification_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_member_receipt_specification_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "adverse_omission_control_id": {"$ref": "#/$defs/canonicalText"},
        "evaluation_gate_id": {"$ref": "#/$defs/canonicalText"}
      }
    },
    "canaryTargetPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "candidate_target_ids", "seed_commitment_sha256", "assignment_artifact_sha256", "masking_plan", "ethical_disclosure", "assessment_gate_id"],
      "properties": {
        "plan_id": {"type": "string", "pattern": "\\S"},
        "candidate_target_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "\\S"}
        },
        "seed_commitment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "assignment_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "masking_plan": {"type": "string", "pattern": "\\S"},
        "ethical_disclosure": {"type": "string", "pattern": "\\S"},
        "assessment_gate_id": {"type": "string", "pattern": "\\S"}
      }
    },
    "analysisContract": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_hypothesis_id", "primary_measurement_id", "method", "outcome_column", "group_column", "groups", "estimand", "contrast_definition", "contrast_groups", "missing_data_policy", "assignment_type", "effect_estimate_path", "uncertainty_path", "null_value", "support_rule", "minimum_analyzable_units", "maximum_excluded_fraction", "maximum_group_excluded_fraction_difference", "missingness_assumption", "missingness_assessment_plan", "missingness_failure_response", "missingness_assessment_kind", "missingness_assessment_gate_id"],
      "properties": {
        "primary_hypothesis_id": {"$ref": "#/$defs/canonicalText"},
        "primary_measurement_id": {"$ref": "#/$defs/canonicalText"},
        "method": {"$ref": "#/$defs/canonicalText"},
        "outcome_column": {"$ref": "#/$defs/canonicalText"},
        "group_column": {"$ref": "#/$defs/canonicalText"},
        "groups": {"type": "array", "items": {"$ref": "#/$defs/canonicalText"}, "minItems": 2, "maxItems": 2, "uniqueItems": true},
        "estimand": {"$ref": "#/$defs/canonicalText"},
        "contrast_definition": {"$ref": "#/$defs/canonicalText"},
        "contrast_groups": {"type": "array", "items": {"$ref": "#/$defs/canonicalText"}, "minItems": 2, "maxItems": 2, "uniqueItems": true},
        "missing_data_policy": {"const": "complete_case"}
        ,"assignment_type": {"enum": ["observational", "randomized_between_units", "nonrandomized", "not_applicable"]}
        ,"allocation_sha256": {"type": "string", "pattern": "^([0-9a-f]{64})?$"}
        ,"effect_estimate_path": {"type": "string", "pattern": "^/"}
        ,"uncertainty_path": {"type": "string", "pattern": "^/"}
        ,"null_value": {"type": "number"}
        ,"support_rule": {"enum": ["point_direction", "interval_excludes_null", "interval_within_equivalence_margin"]}
        ,"confidence_level": {"type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1}
        ,"minimum_analyzable_units": {"type": "integer", "minimum": 2}
        ,"maximum_excluded_fraction": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}
        ,"maximum_group_excluded_fraction_difference": {"type": "number", "minimum": 0, "maximum": 1}
        ,"missingness_assumption": {"type": "string", "pattern": "\\S"}
        ,"missingness_assessment_plan": {"type": "string", "pattern": "\\S"}
        ,"missingness_failure_response": {"type": "string", "pattern": "\\S"}
        ,"missingness_assessment_kind": {"enum": ["empirical_diagnostic", "design_record_review", "external_validation", "substantive_judgment"]}
        ,"missingness_assessment_gate_id": {"type": "string", "pattern": "\\S"}
        ,"adjustment_columns": {"type": "array", "items": {"type": "string", "pattern": "\\S"}, "uniqueItems": true}
      }
    },
    "analysisFamilyMember": {
