        "population": {"type": "string", "pattern": "\\S"},
        "setting": {"type": "string", "pattern": "\\S"},
        "time_window": {"type": "string", "pattern": "\\S"},
        "non_supporting_direction": {"enum": ["inconclusive", "weakens"]},
        "permitted_claim_level": {"enum": ["measurement_validity", "statistical_association", "causal_direction"]},
        "higher_level_conclusions_unsupported": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/boundedReportText"}}
      }
    }
