{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-machine.local/schemas/collaborator-proposal.schema.json",
  "title": "Provider-neutral collaborator proposal",
  "type": "object",
  "required": [
    "proposal_version",
    "proposal_id",
    "context_sha256",
    "generated_by",
    "purpose",
    "summary",
    "uncertainty",
    "competing_explanations",
    "disconfirming_evidence",
    "limitations",
    "suggestions"
  ],
  "properties": {
    "proposal_version": {"const": 1},
    "proposal_id": {"$ref": "#/$defs/canonicalNonEmptyText"},
    "context_sha256": {"$ref": "#/$defs/sha256"},
    "generated_by": {
      "type": "object",
      "required": ["kind", "provider", "model"],
      "properties": {
        "kind": {"enum": ["human", "llm", "hybrid"]},
        "provider": {"$ref": "#/$defs/canonicalText"},
        "model": {"$ref": "#/$defs/canonicalText"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["llm", "hybrid"]}}, "required": ["kind"]},
          "then": {
            "properties": {
              "provider": {"$ref": "#/$defs/canonicalNonEmptyText"},
              "model": {"$ref": "#/$defs/canonicalNonEmptyText"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "purpose": {"$ref": "#/$defs/canonicalNonEmptyText"},
    "summary": {"$ref": "#/$defs/boundedProposalText"},
    "uncertainty": {"$ref": "#/$defs/boundedProposalText"},
    "competing_explanations": {"$ref": "#/$defs/groundedClaimList"},
    "disconfirming_evidence": {"$ref": "#/$defs/groundedClaimList"},
    "limitations": {"$ref": "#/$defs/groundedClaimList"},
    "suggestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "suggestion_id",
          "kind",
          "statement",
          "rationale",
          "uncertainty",
          "evidence_refs",
          "falsification_conditions",
          "next_test",
          "authority"
        ],
        "properties": {
          "suggestion_id": {"$ref": "#/$defs/canonicalNonEmptyText"},
          "kind": {
            "enum": [
              "question",
              "hypothesis",
              "design_revision",
              "analysis_interpretation",
              "next_action"
            ]
          },
          "statement": {"$ref": "#/$defs/boundedProposalText"},
          "rationale": {"$ref": "#/$defs/boundedProposalText"},
          "uncertainty": {"$ref": "#/$defs/boundedProposalText"},
          "evidence_refs": {
            "type": "array",
            "items": {"$ref": "#/$defs/contextRef"},
            "uniqueItems": true
          },
          "falsification_conditions": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/boundedProposalText"},
            "uniqueItems": true
          },
          "next_test": {"$ref": "#/$defs/boundedProposalText"},
          "authority": {"const": "review_only"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "canonicalText": {
      "type": "string",
      "pattern": "^(?:$|\\S|\\S.*\\S)$"
    },
    "canonicalNonEmptyText": {
      "type": "string",
      "pattern": "^(?:\\S|\\S.*\\S)$"
    },
    "boundedProposalText": {
      "allOf": [
        {"$ref": "#/$defs/canonicalNonEmptyText"},
        {
          "not": {
            "pattern": "\\b(?:[Aa][Cc][Cc][Ee][Pp][Tt][Ss]?|[Aa][Cc][Cc][Ee][Pp][Tt][Ee][Dd]|[Aa][Pp][Pp][Rr][Oo][Vv][Ee][Ss]?|[Aa][Pp][Pp][Rr][Oo][Vv][Ee][Dd]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Ee][Ss]?|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Ee][Dd]|[Cc][Oo][Nn][Ff][Ii][Rr][Mm][Ss]?|[Cc][Oo][Nn][Ff][Ii][Rr][Mm][Ee][Dd]|[Pp][Rr][Oo][Vv][Ee][Ss]?|[Pp][Rr][Oo][Vv][Ee][Dd]|[Pp][Rr][Oo][Oo][Ff]|[Vv][Aa][Ll][Ii][Dd][Aa][Tt][Ee][Ss]?|[Vv][Aa][Ll][Ii][Dd][Aa][Tt][Ee][Dd])\\b|[Cc][Aa][Nn][Oo][Nn][Ii][Cc][Aa][Ll] [Ww][Rr][Ii][Tt][Ee]|[Cc][Aa][Nn][Oo][Nn][Ii][Cc][Aa][Ll] [Aa][Cc][Tt][Ii][Oo][Nn]|[Ee][Vv][Ii][Dd][Ee][Nn][Cc][Ee] [Cc][Rr][Ee][Aa][Tt][Ii][Oo][Nn]|[Cc][Rr][Ee][Aa][Tt][Ee][Ss] [Ee][Vv][Ii][Dd][Ee][Nn][Cc][Ee]|[Cc][Rr][Ee][Aa][Tt][Ee][Dd] [Ee][Vv][Ii][Dd][Ee][Nn][Cc][Ee]|[Hh][Uu][Mm][Aa][Nn][- ][Rr][Ee][Vv][Ii][Ee][Ww][Ee][Dd]|[Rr][Ee][Vv][Ii][Ee][Ww][Ee][Dd] [Bb][Yy] [Hh][Uu][Mm][Aa][Nn]|[Rr][Ee][Vv][Ii][Ee][Ww][Ee][Rr] [Ii][Dd][Ee][Nn][Tt][Ii][Tt][Yy] [Aa][Uu][Tt][Hh][Ee][Nn][Tt][Ii][Cc][Aa][Tt][Ee][Dd]|[Aa][Uu][Tt][Hh][Ee][Nn][Tt][Ii][Cc][Aa][Tt][Ee][Dd] [Rr][Ee][Vv][Ii][Ee][Ww][Ee][Rr]|[Aa][Uu][Tt][Hh][Ee][Nn][Tt][Ii][Cc][Aa][Tt][Ee][Dd] [Ii][Dd][Ee][Nn][Tt][Ii][Tt][Yy]|\\b(?:[Ee][Ss][Tt][Aa][Bb][Ll][Ii][Ss][Hh]|[Ee][Ss][Tt][Aa][Bb][Ll][Ii][Ss][Hh][Ee][Ss]|[Ee][Ss][Tt][Aa][Bb][Ll][Ii][Ss][Hh][Ee][Dd]|[Ff][Ii][Nn][Dd]|[Ff][Ii][Nn][Dd][Ss]|[Ff][Oo][Uu][Nn][Dd]|[Dd][Ee][Tt][Ee][Rr][Mm][Ii][Nn][Ee]|[Dd][Ee][Tt][Ee][Rr][Mm][Ii][Nn][Ee][Ss]|[Dd][Ee][Tt][Ee][Rr][Mm][Ii][Nn][Ee][Dd]|[Ss][Hh][Oo][Ww]|[Ss][Hh][Oo][Ww][Ss]|[Ss][Hh][Oo][Ww][Ee][Dd]|[Dd][Ee][Mm][Oo][Nn][Ss][Tt][Rr][Aa][Tt][Ee]|[Dd][Ee][Mm][Oo][Nn][Ss][Tt][Rr][Aa][Tt][Ee][Ss]|[Dd][Ee][Mm][Oo][Nn][Ss][Tt][Rr][Aa][Tt][Ee][Dd])\\b(?:\\s+\\w+){0,6}\\s+\\b(?:[Ll][Ee][Gg][Aa][Ll] [Cc][Hh][Aa][Rr][Aa][Cc][Tt][Ee][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Ll][Ee][Gg][Aa][Ll] [Rr][Ee][Ss][Pp][Oo][Nn][Ss][Ii][Bb][Ii][Ll][Ii][Tt][Yy]|[Ll][Ee][Gg][Aa][Ll] [Ll][Ii][Aa][Bb][Ii][Ll][Ii][Tt][Yy]|[Cc][Uu][Ll][Pp][Aa][Bb][Ii][Ll][Ii][Tt][Yy]|[Ll][Ii][Aa][Bb][Ii][Ll][Ii][Tt][Yy]|[Gg][Uu][Ii][Ll][Tt]|[Nn][Ee][Gg][Ll][Ii][Gg][Ee][Nn][Cc][Ee]|[Ff][Rr][Aa][Uu][Dd][Uu][Ll][Ee][Nn][Tt] [Ii][Nn][Tt][Ee][Nn][Tt]|[Cc][Rr][Ii][Mm][Ii][Nn][Aa][Ll] [Ii][Nn][Tt][Ee][Nn][Tt]|[Ii][Nn][Tt][Ee][Nn][Tt][Ii][Oo][Nn][Aa][Ll] [Ww][Rr][Oo][Nn][Gg][Dd][Oo][Ii][Nn][Gg])\\b|\\b(?:[Ii][Ss]|[Aa][Rr][Ee]|[Ww][Aa][Ss]|[Ww][Ee][Rr][Ee])\\s+(?:[Ll][Ee][Gg][Aa][Ll][Ll][Yy] [Rr][Ee][Ss][Pp][Oo][Nn][Ss][Ii][Bb][Ll][Ee]|[Ll][Ii][Aa][Bb][Ll][Ee]|[Gg][Uu][Ii][Ll][Tt][Yy]|[Nn][Ee][Gg][Ll][Ii][Gg][Ee][Nn][Tt])\\b|[Cc][Oo][Mm][Mm][Ii][Tt][Tt][Ee][Dd] [Ff][Rr][Aa][Uu][Dd]"
          }
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contextRef": {
      "type": "string",
      "pattern": "^(inquiry|question|claim|hypothesis|evidence|dataset|protocol|run|evidence_status_event|ethics_review_event):(?:\\S|\\S.*\\S)$"
    },
    "groundedClaim": {
      "anyOf": [
        {"$ref": "#/$defs/boundedProposalText"},
        {
          "type": "object",
          "required": ["statement", "context_refs"],
          "properties": {
            "statement": {"$ref": "#/$defs/boundedProposalText"},
            "context_refs": {
              "type": "array",
              "items": {"$ref": "#/$defs/contextRef"},
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "groundedClaimList": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/groundedClaim"}
    }
  }
}
